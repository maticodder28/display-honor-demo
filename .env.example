# Copia este archivo como .env.local. En Vercel van en Settings > Environment Variables.

# Modo demo: 1 = sin Supabase ni login, con datos ficticios. Deja vacio para usar la base real.
NEXT_PUBLIC_DEMO=1
# Link al codigo que muestra la franja de la demo (opcional)
NEXT_PUBLIC_REPO_URL=https://github.com/maticodder28/display-honor-demo

# Solo para la version con base de datos (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Zona que muestra este despliegue (debe existir en la tabla zonas)
NEXT_PUBLIC_ZONA=Norte
